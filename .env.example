# Copy to .env and replace every change-me value before starting the container.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-use-a-long-unique-password
APP_SECRET=change-me-use-a-long-random-session-secret
APP_ENCRYPTION_KEY=change-me-use-a-different-long-random-encryption-secret

# YouTube Data API v3 key. Public channel data does not require YouTube OAuth.
YOUTUBE_API_KEY=

# Meta app credentials used for Facebook Page authorization.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Must be the HTTPS URL used to open this app through the VPN/reverse proxy.
APP_BASE_URL=https://hype-bot.example.internal

# For local HTTP testing, set false. Set true behind HTTPS in the server deployment.
COOKIE_SECURE=false
PORT=8000
POLL_INTERVAL_MINUTES=60
DATA_DIR=/data
